    style SERVICE fill:#3b82f6,color:#fff
    style REPO fill:#3b82f6,color:#fff
    style CACHE fill:#eab308,color:#000
    style PGDB fill:#22c55e,color:#000
    style PUBSUB fill:#22c55e,color:#000
    style WORKER fill:#a855f7,color:#fff
