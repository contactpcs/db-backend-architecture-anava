ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://anava_app:CHANGE_ME@your-rds-host.ap-south-1.rds.amazonaws.com:5432/Anava_App_v1
MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@your-rds-host.ap-south-1.rds.amazonaws.com:5432/Anava_App_v1
DB_REQUIRE_SSL=true
AUTH_MODE=cognito
# Self-registered patients (Documents/design_signup_auto_approval.md)
AUTO_APPROVE_SELF_REGISTRATION=true
# Required outside local/test; any long random string.
SIGNUP_HASH_SECRET=change_me
# true ONLY where the API is reachable through the load balancer alone.
TRUST_FORWARDED_FOR=true
LOCAL_JWT_SECRET=dev-only-insecure-secret-do-not-use-in-prod
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_APP_CLIENT_ID=your-cognito-app-client-id
COGNITO_APP_CLIENT_SECRET=your-cognito-app-client-secret
LOCAL_FILE_STORAGE_PATH=./.local_storage
SQS_ENDPOINT_URL=http://localhost:9324
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
FILE_STORAGE_MODE=s3
# Patient records bucket (EEG, medical history, scanned patient uploads)
S3_BUCKET_NAME=your-patient-records-bucket
# Where a patient upload lands first. Unset = patients cannot upload.
S3_QUARANTINE_BUCKET_NAME=your-quarantine-bucket
S3_COMPLIANCE_BUCKET_NAME=your-compliance-bucket
S3_ACCESS_LOGS_BUCKET_NAME=your-access-logs-bucket
S3_KMS_KEY_ARN_PHI=arn:aws:kms:ap-south-1:000000000000:key/your-phi-key-id
S3_KMS_KEY_ARN_COMPLIANCE=arn:aws:kms:ap-south-1:000000000000:key/your-compliance-key-id
S3_PROMOTER_ROLE_ARN=arn:aws:iam::000000000000:role/anava-upload-promoter
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
