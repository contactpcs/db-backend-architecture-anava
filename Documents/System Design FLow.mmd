graph LR
    Client["Client<br/>Web / Mobile App<br/>(Patient, Doctor, Admin, Staff)"]

    subgraph SEC["Security Gate - FastAPI Middleware"]
        CORS["CORS Middleware"]
        AUTH["Auth Middleware<br/>verify JWT, load profile,<br/>build RequestContext"]
        RID["Request ID + Logging"]
    end

    subgraph APP["Application Module - Router / Service / Repository"]
        ROUTER["Router<br/>require_role() check"]
        SERVICE["Service<br/>business rules + scope check"]
        REPO["Repository<br/>SQL queries"]
    end

    CACHE["Redis Cache<br/>cache-aside<br/>profile: 60s TTL<br/>catalogs: 10min TTL"]
    PGDB[("PostgreSQL<br/>RLS + constraints<br/>outbox_events table")]
    PUBSUB["Redis Pub/Sub<br/>SSE channels"]
    WORKER["Event Relay Worker<br/>separate process"]

    subgraph ASYNC2["Notification Fan-out (Stage 13+, not yet built)"]
        SQS["Amazon SQS<br/>notification queue"]
        SES["AWS SES<br/>email delivery"]
        SNS["AWS SNS / Pinpoint<br/>SMS + push delivery"]
    end

    RAZORPAY["Razorpay<br/>payment gateway<br/>(order create + refund)"]
    SWEEP["Hold Expiry Sweep<br/>cron worker, 15min TTL<br/>(planned - appointment payments)"]

    Client -->|"1 - HTTPS request + JWT"| CORS
    CORS -->|"2"| AUTH
    AUTH -->|"3"| RID
    RID -->|"4 - authenticated request"| ROUTER
    ROUTER -->|"5 - authorized call"| SERVICE
    SERVICE -->|"6 - query"| REPO
    REPO -->|"7 - cache GET check"| CACHE
    CACHE -.->|"8 - HIT: cached row"| REPO
    REPO -->|"9 - MISS: query DB"| PGDB
    PGDB -.->|"10 - row returned, populate cache"| CACHE
    REPO -->|"11 - JSON response"| SERVICE
    SERVICE -->|"12"| ROUTER
    ROUTER -->|"13"| Client

    PGDB -->|"14 - LISTEN/NOTIFY wake"| WORKER
    WORKER -->|"15 - publish user:{id}:stream"| PUBSUB
    PUBSUB -.->|"16 - SSE live push"| Client
    WORKER -->|"17 - enqueue notification job"| SQS
    SQS -->|"18 - deliver email"| SES
    SQS -->|"19 - deliver SMS / push"| SNS

    SERVICE -->|"20 - create order / refund"| RAZORPAY
    RAZORPAY -.->|"21 - webhook: payment captured / refunded (public, HMAC verified)"| ROUTER
    SWEEP -->|"22 - poll & expire payment_pending past 15min TTL"| PGDB

