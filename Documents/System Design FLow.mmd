    style SES fill:#94a3b8,color:#000,stroke-dasharray: 5 5,stroke:#475569,stroke-width:2px
    style SNS fill:#94a3b8,color:#000,stroke-dasharray: 5 5,stroke:#475569,stroke-width:2px
    style ASYNC2 fill:#f1f5f9,stroke:#94a3b8,stroke-width:2px,stroke-dasharray: 5 5
    style RAZORPAY fill:#6366f1,color:#fff,stroke:#4338ca,stroke-width:2px
